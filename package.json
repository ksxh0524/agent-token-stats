{
  "name": "agent-token-stats",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "本地看板：统计 coding agent（pi / opencode）的 token 消耗（按数据源 / 工作区 / 会话 / 天 / 模型 / 提供商）",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Asia/Shanghai node --test \"test/*.test.js\" \"test/*.test.ts\"",
    "fmt": "prettier --write \"src/**/*.ts\" \"public/js/*.js\" \"test/**/*\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
